{
    "name": "@universal-error-boundary/core",
    "version": "1.0.0",
    "description": "Shared themes, error-explanation engine and types used by @universal-error-boundary/react and @universal-error-boundary/react-native.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "error-boundary",
        "react",
        "react-native",
        "themes"
    ],
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.6.3"
    }
}
